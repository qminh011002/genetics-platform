# Nginx edge — TLS (staging / production, compose.prod.yaml). Thay cho nginx/default.conf.template.
# Cert: ${TLS_DIR}/fullchain.pem + privkey.pem mount tại /etc/nginx/tls (deploy-vm.md §1).
# Biến env: ${SERVER_NAME}, ${NGINX_HTTP_PORT}, ${NGINX_HTTPS_PORT}, ${NGINX_MAX_BODY}, ${CSP_CONNECT_SRC_EXTRA}.

server {
    listen ${NGINX_HTTP_PORT};
    listen [::]:${NGINX_HTTP_PORT};
    server_name ${SERVER_NAME};
    server_tokens off;

    # Uptime Kuma / healthcheck có thể gọi HTTP; mọi thứ khác → HTTPS.
    location = /healthz {
        default_type text/plain;
        return 200 "ok\n";
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen ${NGINX_HTTPS_PORT} ssl;
    listen [::]:${NGINX_HTTPS_PORT} ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/tls/fullchain.pem;
    ssl_certificate_key /etc/nginx/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_timeout 1d;
    ssl_session_cache shared:genetics_ssl:10m;
    ssl_session_tickets off;

    server_tokens off;
    client_max_body_size ${NGINX_MAX_BODY};

    set $hsts "max-age=31536000; includeSubDomains";
    set $csp "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://login.microsoftonline.com ${CSP_CONNECT_SRC_EXTRA}; worker-src 'self' blob:; manifest-src 'self'; frame-src https://login.microsoftonline.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://login.microsoftonline.com; object-src 'none'";

    include snippets/app-locations.conf;
}
