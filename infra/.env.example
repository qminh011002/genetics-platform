# Genetics Data Platform · mẫu biến môi trường (getting-started.md §6, infrastructure.md §5, deploy-vm.md §1).
# Sao chép thành infra/.env (local) hoặc /opt/genetics/<env>/.env (VM, chmod 600). KHÔNG commit .env.
# Giá trị ở đây là ví dụ cho local; trên VM thay bằng giá trị thật (mật khẩu sinh ngẫu nhiên: `openssl rand -hex 24`).

# ---- Chung -----------------------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=genetics      # tên stack; VM: genetics-staging | genetics-production
ENV=local                          # local | test | staging | production (production tắt Swagger)
AUTH_MODE=dev                      # dev (nhận X-Dev-User) | entra (kiểm JWT) — staging/production bắt buộc entra
LOG_LEVEL=INFO

# ---- Image (compose.prod.yaml) ----------------------------------------------------------------------
REGISTRY=ghcr.io/<org>             # registry GHCR; chỉ dùng trên VM
IMAGE_TAG=local                    # local: build tại máy; staging: sha-<sha>; production: vX.Y.Z — deploy.sh tự ghi
# API_IMAGE=genetics-api           # (local) ghi đè tên image khi dùng stub để kiểm compose
# WEB_IMAGE=genetics-web
# MOBILE_IMAGE=genetics-mobile

# ---- PostgreSQL 18 ----------------------------------------------------------------------------------
POSTGRES_DB=genetics
POSTGRES_PASSWORD=change-me-postgres          # superuser `postgres`; chỉ dùng cho bảo trì
APP_MIGRATOR_PASSWORD=change-me-migrator      # role app_migrator (Alembic, backup)
APP_RW_PASSWORD=change-me-rw                  # role app_rw (api, worker)
APP_ANALYTICS_RO_PASSWORD=change-me-ro        # role app_analytics_ro (Metabase / báo cáo)
POSTGRES_PORT=5432                            # cổng publish ra 127.0.0.1 ở local; prod không publish
POSTGRES_TEST_PORT=5433                       # profile test

# URL cho tiến trình chạy NGOÀI compose (uv run ... trên máy dev). Trong compose, api/worker nhận URL
# tới host `postgres` sinh từ các mật khẩu ở trên (xem compose.yaml x-app-env).
DATABASE_URL=postgresql+psycopg://app_rw:change-me-rw@localhost:5432/genetics
MIGRATION_DATABASE_URL=postgresql+psycopg://app_migrator:change-me-migrator@localhost:5432/genetics

# ---- Backend ----------------------------------------------------------------------------------------
API_PORT=8000                                 # publish ra 127.0.0.1 ở local
ENTRA_TENANT_ID=                              # bắt buộc khi AUTH_MODE=entra
ENTRA_API_CLIENT_ID=
ENTRA_WEB_CLIENT_ID=
ENTRA_MOBILE_CLIENT_ID=
FILE_STORAGE_ROOT=./.data/files               # ngoài compose; trong compose = /data/files (volume/bind FILES_DIR)
PUBLIC_WEB_URL=http://localhost:5173          # VM: https://<host>
PUBLIC_MOBILE_URL=http://localhost:5174       # VM: https://<host>/app
SENTRY_DSN=
SMTP_HOST=                                    # dev: mailpit (compose.dev.yaml tự đặt)
SMTP_PORT=1025
SMTP_FROM=genetics-noreply@example.com

# ---- Frontend (Vite, chỉ biến không nhạy cảm; build-time với image web/mobile) ------------------------
VITE_API_URL=http://localhost:8000/api/v1
VITE_AUTH_MODE=dev
VITE_API_MOCK=0
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_WEB_CLIENT_ID=
VITE_ENTRA_MOBILE_CLIENT_ID=

# ---- Nginx edge --------------------------------------------------------------------------------------
SERVER_NAME=localhost                         # VM: tên miền nội bộ / public (khớp cert)
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443                          # chỉ compose.prod.yaml
NGINX_MAX_BODY=25m                            # giới hạn upload (ADR-0015)
CSP_CONNECT_SRC_EXTRA=                        # thêm origin cho connect-src, ví dụ https://<id>.ingest.sentry.io
TLS_DIR=./tls                                 # chứa fullchain.pem + privkey.pem (chỉ prod)

# ---- Backup / dữ liệu (infrastructure.md §7, deploy-vm.md §6) ----------------------------------------
BACKUP_DIR=./backups                          # VM: /opt/genetics/<env>/backups
FILES_DIR=./files                             # VM: /opt/genetics/<env>/files (chỉ compose.prod.yaml)
BACKUP_TIME=02:00                             # giờ pg_dump hằng ngày (giờ của container, UTC nếu không set TZ)
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
OFFSITE_TARGET=                               # đích rsync: user@host:/path hoặc /mnt/share/genetics; rỗng = bỏ qua
# TZ=Asia/Ho_Chi_Minh                         # bỏ comment để cron backup theo giờ địa phương

# ---- Công cụ dev (compose.dev.yaml, profile dev) -------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=dev@example.com
PGADMIN_DEFAULT_PASSWORD=pgadmin
PGADMIN_PORT=5050
MAILPIT_PORT=8025
MAILPIT_SMTP_PORT=1025

# ---- Vận hành (profile ops) ---------------------------------------------------------------------------
UPTIME_KUMA_PORT=3001

# ---- deploy.sh ----------------------------------------------------------------------------------------
# COMPOSE_FILES="-f compose.yaml -f compose.prod.yaml"   # mặc định trên VM
# DEPLOY_LOG=/opt/genetics/src/docs/ops/deploy-log.md    # mặc định: <repo>/docs/ops/deploy-log.md cạnh infra/
# SMOKE_BASE_URL=https://<host>                          # mặc định = PUBLIC_WEB_URL
# SMOKE_INSECURE=1                                       # cert tự ký: curl -k
