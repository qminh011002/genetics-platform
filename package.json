{
  "name": "genetics-platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22",
    "pnpm": ">=12"
  },
  "scripts": {
    "prepare": "husky",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "build:tokens": "pnpm --filter @genetics/design-tokens build",
    "generate": "pnpm --filter @genetics/api-client generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:visual": "turbo run test:visual",
    "contract:check": "pnpm --filter @genetics/backend export-openapi && pnpm generate && git diff --exit-code -- contracts packages/api-client/src/generated",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,json,yaml,yml,css}\" \"!.claude/**\" \"!.codex/**\" \"!**/.import_linter_cache/**\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,json,yaml,yml,css}\" \"!.claude/**\" \"!.codex/**\" \"!**/.import_linter_cache/**\"",
    "check:catalog": "node scripts/check-catalog.mjs",
    "ci": "pnpm format:check && pnpm check:catalog && pnpm lint && pnpm typecheck && pnpm test && pnpm contract:check && pnpm build"
  },
  "lint-staged": {
    "{apps,packages}/**/*.{ts,tsx,js,mjs,cjs}": "eslint --fix --no-warn-ignored",
    "*.{ts,tsx,js,mjs,cjs,json,yaml,yml,css}": "prettier --write"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-i18next": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:"
  }
}
